{
  "name": "nj-fence",
  "version": "0.1.0",
  "private": true,
  "description": "NJ Fence and Railing Management System",
  "author": "NJ Fence",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.njfence.app",
    "productName": "NJ Fence",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NJ Fence"
    },
    "asar": true,
    "asarUnpack": [
      ".next/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/**/*",
      "prisma/**/*"
    ],
    "files": [
      "main.js",
      "package.json",
      "public/**/*",
      ".next/**/*",
      "prisma/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.22.0",
    "typescript": "^5",
    "wait-on": "^9.1.0",
    "webpack-cli": "^7.2.2"
  }
}
